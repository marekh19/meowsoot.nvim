# name: 'meowsoot-dawn'
# url: 'https://github.com/marekh19/meowsoot.nvim'
# meowsoot - Fish shell theme.
# Auto-generated from lua/meowsoot/palette.lua. Do not edit by hand.
# Install:  cp extras/fish/meowsoot-dawn.theme ~/.config/fish/themes/
# Select:   fish_config theme choose meowsoot-dawn

# Syntax Highlighting Colors
fish_color_normal 3c312a
fish_color_command 187a8b
fish_color_keyword 6a2c96
fish_color_quote 917112
fish_color_redirection 187a8b
fish_color_end 3c312a
fish_color_error a11717
fish_color_param 3c312a
fish_color_option a34414
fish_color_comment 7e7063
fish_color_selection --background=d7cac1
fish_color_operator 187a8b
fish_color_escape a34414
fish_color_autosuggestion 7e7063
fish_color_cwd 187a8b
fish_color_cwd_root a11717
fish_color_valid_path --underline
fish_color_history_current --bold
fish_color_search_match --background=d7cac1
fish_color_match 116374
fish_color_cancel a11717

# Completion Pager Colors
fish_pager_color_progress 7e7063
fish_pager_color_prefix 187a8b
fish_pager_color_completion 3c312a
fish_pager_color_description 7e7063
fish_pager_color_selected_background --background=d7cac1
fish_pager_color_selected_completion 3c312a
fish_pager_color_selected_description 7e7063
fish_pager_color_selected_prefix 187a8b
